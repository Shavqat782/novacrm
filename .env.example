# NovaCRM - Environment Variables
# Скопируйте этот файл в .env.local и заполните своими ключами.
# НИКОГДА не коммитьте .env.local в git!

# Supabase PostgreSQL Database
# Получите с https://app.supabase.com -> Settings -> API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Google Gemini (https://ai.google.dev)
# ВАЖНО: в dev-режиме положите ключ также в GEMINI_API_KEY (без префикса VITE_),
# тогда он будет ходить через серверный прокси /gemini-api и не попадёт в бандл.
GEMINI_API_KEY=YOUR_GEMINI_KEY
VITE_GEMINI_API_KEY=YOUR_GEMINI_KEY